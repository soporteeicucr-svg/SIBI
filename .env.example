# Copiar este archivo a .env y completar los valores antes de ejecutar docker compose up
# El archivo .env nunca debe subirse al repositorio

# Contraseña del usuario 'sa' de SQL Server
# Requisitos: min. 8 caracteres, mayúscula, minúscula, número y símbolo especial
MSSQL_SA_PASSWORD=

# Clave secreta para firmar los JWT (mínimo 32 caracteres, completamente aleatoria)
# Generar con: openssl rand -base64 48
JWT_KEY=

